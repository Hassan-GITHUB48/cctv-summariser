# Copy to .env and fill in. Never commit .env.
LOG_LEVEL=INFO
YOLO_MODEL=yolov8n.pt

# Postgres (docker compose maps the container to this host port)
POSTGRES_USER=cctv
POSTGRES_PASSWORD=cctv
POSTGRES_DB=cctv
POSTGRES_PORT=5433
DATABASE_URL=postgresql://cctv:cctv@localhost:5433/cctv

# LLM report
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallback: "default" lets the API pick a fallback model; leave empty to disable
ANTHROPIC_FALLBACKS=default
