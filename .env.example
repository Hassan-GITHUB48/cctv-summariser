# Copy to .env and fill in. Never commit .env.
LOG_LEVEL=INFO
YOLO_MODEL=yolov8n.pt

# Postgres (docker compose maps the container to this host port)
POSTGRES_USER=cctv
POSTGRES_PASSWORD=cctv
POSTGRES_DB=cctv
POSTGRES_PORT=5433
DATABASE_URL=postgresql://cctv:cctv@localhost:5433/cctv

# LLM report
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Server-side refusal fallback: "default" lets the API pick a fallback model; leave empty to disable
ANTHROPIC_FALLBACKS=default

# API
OUTPUT_DIR=output
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=500
# Jobs beyond this wait in "queued" (YOLO/FFmpeg are CPU-heavy)
MAX_CONCURRENT_JOBS=1
# Comma-separated; Vite dev server by default
CORS_ORIGINS=http://localhost:5173
